[Unit]
Description=ETH Options Command Center FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/eth-options-command-center
EnvironmentFile=-/opt/eth-options-command-center/.env
Environment=PYTHONUNBUFFERED=1
Environment=FUTURES_LIVE_TRADING_ENABLED=false
Environment=BACKEND_SCHEDULER_ENABLED=true
Environment=BACKEND_JOB_TIMEOUT_SECONDS=50
Environment=MARKET_REFRESH_INTERVAL_SECONDS=300
Environment=PAPER_TRADING_INTERVAL_SECONDS=300
Environment=FUTURES_TRADING_INTERVAL_SECONDS=300
Environment=OPTION_CHAIN_REFRESH_INTERVAL_SECONDS=300
Environment=SMC_REFRESH_INTERVAL_SECONDS=900
Environment=VOLUME_PROFILE_REFRESH_INTERVAL_SECONDS=900
ExecStart=/opt/eth-options-command-center/deployment/start_fastapi.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=append:/opt/eth-options-command-center/logs/fastapi-systemd.log
StandardError=append:/opt/eth-options-command-center/logs/fastapi-systemd-error.log
SyslogIdentifier=eth-fastapi

[Install]
WantedBy=multi-user.target
