[Unit]
Description=ETH Options Command Center Streamlit frontend
After=network-online.target eth-fastapi.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/eth-options-command-center
EnvironmentFile=-/opt/eth-options-command-center/.env
Environment=PYTHONUNBUFFERED=1
Environment=BACKEND_SCHEDULER_ENABLED=true
Environment=BACKEND_JOB_TIMEOUT_SECONDS=50
Environment=FASTAPI_BACKEND_URL=http://127.0.0.1:8000
ExecStart=/opt/eth-options-command-center/deployment/start_streamlit.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=append:/opt/eth-options-command-center/logs/streamlit-systemd.log
StandardError=append:/opt/eth-options-command-center/logs/streamlit-systemd-error.log
SyslogIdentifier=eth-streamlit

[Install]
WantedBy=multi-user.target
